{
  "name": "Panasonic AC CSV Viewer",
  "short_name": "AC CSV Viewer",
  "description": "Offline Panasonic air-conditioner CSV chart viewer",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f8",
  "theme_color": "#1769aa",
  "icons": [
    {"src":"icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any maskable"}
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/csv": [".csv"],
        "application/csv": [".csv"],
        "application/vnd.ms-excel": [".csv"]
      }
    }
  ]
}